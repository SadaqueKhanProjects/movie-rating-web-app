{
  "name": "movie-rating-web-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "start": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist",
    "test": "node --test tests/*.test.js",
    "check": "node --check dist/app.js && node --check dist/core.js && node --check dist/account-model.js && node --check src/firebase-client.js && node --check scripts/build.mjs && node --check dist/sw.js",
    "build": "node scripts/build.mjs",
    "build:emulators": "node scripts/build.mjs --emulators",
    "test:integration": "firebase emulators:exec --project demo-frame --only auth,firestore \"node --test tests/cloud.integration.js\"",
    "emulators": "firebase emulators:start --project demo-frame --only auth,firestore"
  },
  "dependencies": {
    "firebase": "13.1.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "firebase-tools": "15.34.2"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}
